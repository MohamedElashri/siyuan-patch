diff --git a/Dockerfile b/Dockerfile
index 42c33c5..0b891e6 100644
--- a/Dockerfile
+++ b/Dockerfile
@@ -148,6 +148,7 @@ RUN --mount=type=cache,target=/root/.cache/go-build \
